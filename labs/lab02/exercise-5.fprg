    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="NumPhotos" type="Integer" array="False" size=""/>
            <declare name="TotalCost" type="Real" array="False" size=""/>
            <output expression="&quot;Enter number of Photos:&quot;" newline="True"/>
            <input variable="NumPhotos"/>
            <assign variable="TotalCost" expression="2+(NumPhotos*0.5)"/>
            <output expression="TotalCost" newline="True"/>
        </body>
    </function>
