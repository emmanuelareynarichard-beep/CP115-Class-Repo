<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="exercise-1"/>
        <attribute name="authors" value="PC"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-06-30 12:26:39 AM"/>
        <attribute name="created" value="UEM7TEFQVE9QLUdVTTZMUE5SOzIwMjYtMDYtMzA7MTI6MjE6MjEgQU07MjUxNg=="/>
        <attribute name="edited" value="UEM7TEFQVE9QLUdVTTZMUE5SOzIwMjYtMDYtMzA7MTI6MjY6MzggQU07MTsyNjM3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="AmountOfRinggit, ExchangeRate, Commission, AmountOfBahtreceived" type="Real" array="False" size=""/>
            <output expression="&quot;Enter amount of Malaysian Ringgit: &quot;" newline="True"/>
            <input variable="AmountOfRinggit"/>
            <output expression="&quot;Enter today's exchange rate (Baht per 1 Ringgit): &quot;" newline="True"/>
            <input variable="ExchangeRate"/>
            <assign variable="Commission" expression="AmountOfRinggit * 0.02"/>
            <assign variable="AmountOfBahtreceived" expression="(AmountOfRinggit - Commission) * ExchangeRate"/>
            <output expression="&quot;Amount of Thai Baht received: &quot; &amp; AmountOfBahtreceived" newline="True"/>
        </body>
    </function>
</flowgorithm>
