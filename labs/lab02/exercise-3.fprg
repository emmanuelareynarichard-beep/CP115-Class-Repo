            <input variable="Hours"/>
            <assign variable="PowerInkW" expression="PowerInWatts/1000"/>
            <assign variable="CostPerNight" expression="PowerInk*Hours*0.218"/>
            <assign variable="CostPerMonth" expression="CostPerNight*30"/>
            <output expression="&quot;The cost to run the air conditioner each night is RM&quot; &amp; CostPerNight" newline="True"/>
